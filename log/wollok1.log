n                game.addVisual(pared)\r\n            } else if (tipoElemento == 2) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"autoGrande.png\")\r\n            game.addVisual(auto)\r\n            } else if (tipoElemento == 3) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_0.png\")\r\n            game.addVisual(auto)\r\n            }else if (tipoElemento == 4) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_1.png\")\r\n            game.addVisual(auto)\r\n            }else if (tipoElemento == 5) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_2.png\")\r\n            game.addVisual(auto)\r\n            }else if (tipoElemento == 6) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_3.png\")\r\n            game.addVisual(auto)\r\n            }else if (tipoElemento == 7) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_4.png\")\r\n            game.addVisual(auto)\r\n             }else if (tipoElemento == 8) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_5.png\")\r\n            game.addVisual(auto)\r\n            } else if (tipoElemento == 9) {           //agregue el numero 2 y le pase la imagen como condicion\r\n            const auto = new obstaculo(position = game.at(x, y), image = \"sprite_6.png\")\r\n            game.addVisual(auto)\r\n        